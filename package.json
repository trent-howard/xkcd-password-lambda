{
  "name": "cdk-lambda",
  "version": "0.1.0",
  "bin": {
    "cdk-lambda": "bin/cdk-lambda.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "compile": "rm -r ./dist ; cd ./src/app && GOARCH=arm64 GOOS=linux go build -tags lambda.norpc -o ../../dist/bootstrap main.go",
    "destroy": "cdk destroy --force",
    "deploy": "pnpm compile && cdk deploy ---require-approval never"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "aws-cdk": "2.1115.1",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.246.0",
    "constructs": "^10.6.0",
    "source-map-support": "^0.5.21"
  }
}
